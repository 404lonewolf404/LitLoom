# OpenAI-compatible model configuration (optional)
# Never commit a real key. The application reads this file only when you
# The application loads the project-root .env automatically. System
# environment variables take precedence over values from that file.
# Fill either the service root or a complete generation endpoint. Leave both
# empty to keep AI features disabled until configured in the UI.
LIT_AGENT_BASE_URL=
LIT_AGENT_API_URL=
LIT_AGENT_EMBEDDING_MODEL=
LIT_AGENT_EMBEDDING_API_URL=
LIT_DEEPSEEK_SEARCH_ENABLED=0
# Optional overrides for DeepSeek Search & Fetch. Leave empty to use the
# official endpoints when the configured model service is api.deepseek.com.
LIT_DEEPSEEK_SEARCH_API_URL=
LIT_DEEPSEEK_FETCH_API_URL=
LIT_AGENT_FAST_MODEL=
LIT_AGENT_ANALYSIS_MODEL=
LIT_AGENT_VISION_MODEL=

# Optional convenience values for the DeepSeek OpenAI-compatible endpoint:
# LIT_AGENT_BASE_URL=https://api.deepseek.com
# LIT_AGENT_API_URL=https://api.deepseek.com/chat/completions
# LIT_AGENT_MODEL=deepseek-flash
# Embeddings are optional. Only configure them if the chosen provider supports it.
# LIT_AGENT_EMBEDDING_MODEL=provider-embedding-model
# LIT_AGENT_EMBEDDING_API_URL=https://api.example.com/v1/embeddings

# Local data protection. Automatic archives run while the app is open.
LITERATURE_AUTO_BACKUP_HOURS=24
LITERATURE_BACKUP_RETENTION=14
# PostgreSQL is required for every application runtime; there is no SQLite fallback.
# Keep credentials local and never commit them; the desktop server stays on loopback.
LITLOOM_DATABASE_URL=
# SQLAlchemy PostgreSQL QueuePool, created on demand.
LITLOOM_DB_POOL_MAX=12
LITLOOM_DB_POOL_TIMEOUT=30
# Optional external location for archived legacy SQLite files (not used at runtime).
# LITLOOM_SQLITE_ARCHIVE_DIR=C:\LitLoom\legacy-sqlite
# Required only for the app-managed local PostgreSQL cluster/autostart.
# LITLOOM_POSTGRES_DATA_DIR=C:\LitLoom\PostgreSQL\data
# LITLOOM_POSTGRES_BIN_DIR=C:\Program Files\PostgreSQL\17\bin
LIT_AGENT_MODEL=
LIT_AGENT_API_KEY=replace-me
# Optional: read/write the key from a local JSON or plain-text file. When not
# set, the default is <LITERATURE_DATA_DIR>/model-secret.json.
LIT_AGENT_API_KEY_FILE=

# Optional model JSON output cap. Set 0 to omit the provider-specific token
# hint and let the configured model decide its available output length.
# 0 = do not send an application-side output cap; use a positive value only
# when a provider or local resource budget requires one.
LIT_AGENT_MAX_OUTPUT_TOKENS=0
# Resource budgets for long-running full-text analysis. The defaults keep a
# local desktop responsive; raise only when the machine and relay can handle it.
LIT_AGENT_MODEL_CONCURRENCY=4
# Independent AI jobs can run in two controlled workers.  The shared model
# semaphore and PDF/render limits still cap provider and desktop resource use.
LIT_AGENT_AI_JOB_CONCURRENCY=2
LIT_AGENT_FULLTEXT_CONCURRENCY=4
LIT_AGENT_MODEL_SLOT_TIMEOUT=30
LIT_AGENT_PDF_RENDER_CONCURRENCY=1
LIT_AGENT_CHUNK_MAX_OUTPUT_TOKENS=0
LIT_AGENT_SYNTHESIS_MAX_OUTPUT_TOKENS=0
LIT_AGENT_READING_CARD_CHUNK_MAX_OUTPUT_TOKENS=0
LIT_AGENT_READING_CARD_SYNTHESIS_MAX_OUTPUT_TOKENS=0
LIT_AGENT_IMAGE_DETAIL=auto
LIT_AGENT_VISUAL_DPI=120
LIT_AGENT_VISUAL_JPEG_QUALITY=68
# Moderate chunks allow independent paper sections to run concurrently while
# retaining the complete PDF text as the evidence backbone.
LIT_AGENT_FULLTEXT_CHUNK_CHARS=14000
LIT_AGENT_DEEP_READ_VISUAL_PAGES_PER_CHUNK=2
# Structured page extraction and visual-page checks use the provider's lowest
# explicit reasoning tier by default. This avoids a relay silently selecting a
# slow/high default for a bounded JSON extraction pass. It does not cap output
# tokens; set to low/medium/high when extra deliberation is preferred.
LIT_AGENT_ANALYSIS_REASONING_EFFORT=minimal
# Only recheck rendered pages with explicit figure/table/equation cues when
# the first visual pass returned no observation. 0 disables this recovery pass.
LIT_AGENT_DEEP_READ_VISUAL_RECHECK_MAX_PAGES=1
# Fast first-pass reading-card profile. High-signal pages are selected from the
# local full text; page images are disabled here. Deep read keeps its separate
# visual budget. Restart the local server to apply.
LIT_AGENT_READING_CARD_CHUNK_CHARS=100000
LIT_AGENT_READING_CARD_CONTEXT_CHARS=36000
# Fast reading cards are text-only. Deep read remains multimodal.
# Stream model output so long relay requests keep the connection active;
# compatible gateways that reject streaming are retried once without it.
LIT_AGENT_STREAM=1
# Retry only transient relay/index failures (408/429/5xx, connection reset,
# and read timeout). Authentication and malformed-request errors fail fast.
LIT_AGENT_TRANSIENT_RETRIES=2
LIT_AGENT_RETRY_BASE_DELAY=0.35
LIT_AGENT_RETRY_MAX_DELAY=2.0
# Bound reasoning on ordinary summaries and deep reads. "low" is the
# responsive default; empty disables this optional field for strict relays.
LIT_AGENT_REASONING_EFFORT=low
# Maximum wait for the optional real inference probe. The quick connection
# probe uses the provider's /models endpoint when available.
LIT_AGENT_PROBE_TIMEOUT=8
# Keep the short test prompt responsive on reasoning models. Empty disables
# the optional OpenAI-compatible reasoning effort field for strict relays.
LIT_AGENT_PROBE_REASONING=low

# Optional web discovery lane for AI literature search. The key stays in this
# local file and is never stored in the LitLoom database or emitted in logs.
# If empty, LitLoom also checks <project-parent>/tavily.txt for a local key.
LIT_TAVILY_API_KEY_FILE=

# AI-led search budgets. Two sources per model angle are queried concurrently;
# the model can still use several angles and all returned candidates are kept.
# Lower the source timeout only for the AI search lane; normal saved searches
# keep the broader public-source timeout.
LIT_AGENT_MODEL_SEARCH_SOURCE_TIMEOUT=4
LIT_AGENT_MODEL_SEARCH_CONTINUATION_TIMEOUT=2
LIT_MODEL_SEARCH_MAX_SOURCES=2
LIT_AGENT_SEARCH_EVIDENCE_ABSTRACT_CHARS=1200
# Keep one extra local candidate for relevance filtering before the final
# ranking request. Increase only when a relay needs a larger ranking pool.
LIT_MODEL_SEARCH_EARLY_STOP_BUFFER=1

# Optional scholarly-index credentials. These are read from the process
# environment/.env and sent only to their matching provider. They are never
# stored in PostgreSQL or returned by diagnostics. Restart LitLoom after editing.
LIT_OPENALEX_API_KEY=
LIT_SEMANTIC_SCHOLAR_API_KEY=

# Local service defaults
LITERATURE_HOST=127.0.0.1
LITERATURE_PORT=8765

# Optional deterministic canary rollout. Empty features keep stable behavior.
# LITLOOM_RELEASE_CHANNEL=stable
# LITLOOM_CANARY_FEATURES=search-ranker-v2
# LITLOOM_CANARY_PERCENT=0
# LITLOOM_CANARY_SALT=change-this-per-release
# Optional local account and role protection for a shared workspace on this machine.
# This does not expose the service to a LAN; LITERATURE_HOST remains loopback-only.
# LITLOOM_AUTH_MODE=team
# Optional passwordless button on the login screen. The server accepts this
# route only from a same-origin loopback browser and assigns researcher role.
# Keep disabled on shared/public deployments.
# LITLOOM_LOCAL_AUTO_LOGIN=0
# LITLOOM_LOCAL_AUTO_LOGIN_USERNAME=local.default
# LITLOOM_LOCAL_AUTO_LOGIN_DISPLAY_NAME=Local Researcher
# PostgreSQL currently supports shared workspace mode only. Isolated tenant
# mode is rejected until PostgreSQL row-level isolation is implemented.
# LITLOOM_TENANT_MODE=isolated
# LITERATURE_ENV_FILE=C:\ResearchData\literature-desk.env
# LITERATURE_DATA_DIR=C:\ResearchData\literature-desk

# Optional MCP stdio adapter. Start `python mcp_server.py` (or the installed
# `litloom-mcp` command) from an MCP client after the LitLoom web service is
# running. The adapter forwards only allow-listed local API calls and never
# reads or returns the model API key.
LITLOOM_URL=http://127.0.0.1:8772
LITLOOM_MCP_TIMEOUT_SECONDS=120
# Optional when LITLOOM_AUTH_MODE=team. Bind the token to an active member;
# the member's normal role restrictions and audit actor are preserved.
# Prefer a protected file outside the repository for the token.
LITLOOM_MCP_TOKEN_FILE=
LITLOOM_MCP_TOKEN=
LITLOOM_MCP_USERNAME=
# If the member belongs to more than one workspace, this must be set to the
# exact workspace UUID; an ambiguous token is rejected instead of choosing one.
LITLOOM_MCP_WORKSPACE_ID=
