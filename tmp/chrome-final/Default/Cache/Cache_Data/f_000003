        if(retryable){lastError=new Error(detail);await sleep(350);continue;}
        throw new Error(detail);
      }
      return data;
    }catch(error){
      const timedOut=error?.name==='AbortError';
      lastError=timedOut?new Error(`请求超时（${Math.round(API_TIMEOUT_MS/1000)} 秒）：${url}`):error;
