 const jobs=settingsSnapshot.aiJobs||[], sync=settingsSnapshot.syncJobs||[];const jobRows=[...jobs.map(job=>({...job,_kind:'ai'})),...sync.map(job=>({...job,_kind:'sync'}))].sort((a,b)=>String(b.updated_at||'').localeCompare(String(a.updated_at||''))).slice(0,20);const jobRowsMarkup=jobRows.length?jobRows.map(job=>{if(job._kind==='sync'){const status=job.status==='success'?'已完成':job.status==='running'?'运行中':job.status==='interrupted'?'上次运行中断':job.status==='retryable'?'等待重试':job.status==='partial'?'部分完成':job.status==='failed'?'失败':job.status;const current=Number(job.progress_current||0),total=Number(job.progress_total||0),progress=total?` · 来源 ${current}/${total}`:'';const source=job.current_source?` · ${SOURCE_NAME[job.current_source]||job.current_source}`:'';const retryable=['failed','partial','interrupted','retryable'].includes(job.status);return `<div class="source-line"><span><b>文献检索 · ${esc(status)}</b><small style="display:block;color:#9aa59d;margin-top:3px">${esc(job.query_name||job.query_id||'研究主题')} · ${esc(job.stage||'')}${progress}${source}${job.last_error||job.run_error?` · ${esc(job.last_error||job.run_error)}`:''}</small></span><span>${job.status==='running'?'进行中':job.duration_ms?`${Math.round(Number(job.duration_ms)/1000)} 秒`:job.updated_at?esc(fmtDate(job.updated_at,true)):''}${retryable?` <button class="button small" data-discovery-history-rerun="${esc(job.run_id||'')}">重试</button>`:''}</span></div>`;}const total=Number(job.progress_total||0),current=Number(job.progress_current||0),pct=total?Math.round(current/total*100):job.status==='success'?100:0;const retryable=['failed','partial','interrupted','cancelled'].includes(job.status);return `<div class="source-line"><span><b>${esc(aiJobLabel(job))}</b> · ${esc(job.paper_title||job.paper_id)}<small style="display:block;color:#9aa59d;margin-top:3px">${esc(job.message||'')} ${job.error?` · ${esc(job.error)}`:''}</small></span><span>${esc(aiJobStatusText(job))}${total?` · ${current}/${total} (${pct}%)`:''}${retryable?` <button class="button small" data-retry-ai-job="${esc(job.id)}">重试</button>`:''}</span></div>`;}).join(''):'<div class="empty-state" style="padding:12px">还没有后台任务</div>';
