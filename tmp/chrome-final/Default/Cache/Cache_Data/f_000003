 if(aiJobPollers[paperId]?.timer)clearTimeout(aiJobPollers[paperId].timer);
 const state={jobId,timer:null};aiJobPollers[paperId]=state;
 const tick=async()=>{try{const job=await api(`/api/ai-jobs/${jobId}`);updateGlobalAiJob(job);renderAiJobStatus(job);if(['queued','running'].includes(job.status)){state.timer=setTimeout(tick,2500);return;}delete aiJobPollers[paperId];if(['success','partial'].includes(job.status)){if(activeModalPaperId===paperId)await loadAiAnalysis(paperId);if(activeView==='prereading')await loadStudyItems(true);if(['abstract_brief','reading_card'].includes(job.job_type)&&activeModalPaperId===paperId){await refresh();await openPaper(paperId);}toast(job.status==='partial'?`${aiJobLabel(job)}保留了可核验的部分结果；点击“仅重新汇总”可复用证据`:(job.options?.synthesis_only_artifact_id?'仅基于已保存证据完成了精读汇总':`${aiJobLabel(job)}已完成`));}else if(job.status==='failed'){toast(`${aiJobLabel(job)}失败：${job.error||'请查看任务详情'}`,'error');}}catch(err){scheduleGlobalAiJobsRefresh();state.timer=setTimeout(tick,4000);}};
 tick();
}
