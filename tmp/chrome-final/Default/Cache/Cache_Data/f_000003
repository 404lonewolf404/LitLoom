function renderAiJobStatus(job){const target=$('#ai-job-status');if(!target||!job||(job.paper_id&&activeModalPaperId&&job.paper_id!==activeModalPaperId))return;const total=Number(job.progress_total||0),current=Math.min(total,Number(job.progress_current||0)),pct=total?Math.round(current/total*100):['success','partial'].includes(job.status)?100:0;const tone=['failed','interrupted','cancelled'].includes(job.status)?'ai-error':job.status==='partial'?'ai-partial-status':job.status==='success'?'evaluation-status':'';const retryable=['failed','interrupted','cancelled','partial'].includes(job.status);const synthesisOnly=job.job_type==='deep_read'&&Boolean(job.options?.synthesis_only_artifact_id);const retryLabel=(job.status==='partial'&&job.job_type==='deep_read')||synthesisOnly?'仅重新汇总':'重新运行';target.innerHTML=`<div class="ai-job-line"><span class="${tone}"><b>${esc(aiJobLabel(job))} · ${esc(aiJobStatusText(job))}</b>${job.message?` · ${esc(job.message)}`:''}</span><span>${total?`${current}/${total} · ${pct}%`:''}${job.duration_ms?` · ${Math.round(Number(job.duration_ms)/1000)} 秒`:''}</span></div>${total&&job.status==='running'?`<div class="ai-job-progress"><i style="width:${pct}%"></i></div>`:''}${job.error?`<div class="${job.status==='partial'?'ai-quality-warning':'ai-error'}">${esc(job.error)}</div>`:''}${['queued','running'].includes(job.status)?`<button class="button small" data-cancel-ai-job="${esc(job.id)}">取消任务</button>`:''}${retryable?`<button class="button small" data-retry-ai-job="${esc(job.id)}">${retryLabel}</button>`:''}`;}
async function watchAiJob(paperId, jobId){
