function agentConfigModal(){Promise.all([api('/api/settings/model'),api('/api/settings/model/providers')]).then(([s,catalog])=>{modelProviderCatalog=catalog.providers||[];agentConfigured=s.api_key_set&&s.enabled;const currentPreset=modelProviderCatalog.find(item=>item.name===s.provider);const presetOptions=['<option value="">手动填写 / 自定义</option>',...modelProviderCatalog.map(item=>`<option value="${esc(item.id)}" ${currentPreset?.id===item.id?'selected':''}>${esc(item.name)}</option>`)].join('');const modelHints=modelProviderCatalog.flatMap(item=>item.models||[]).map(model=>`<option value="${esc(model)}">`).join('');openModal(`<div class="modal-head"><div><h3>模型配置中心</h3><p>支持任意 OpenAI 兼容服务。选择预设只会填入可编辑的地址和模型，不会保存或共享密钥。</p></div><button class="close-button" data-close-modal>×</button></div><form id="model-settings-form"><div class="modal-body"><div class="form-grid"><div class="form-field full"><label>快速选择接口</label><select class="field-input" id="model-provider-preset">${presetOptions}</select><span class="form-help">DeepSeek 使用 Chat Completions；切换供应商后请填写对应 API Key。</span></div><div class="form-field"><label>供应商名称</label><input class="field-input" name="provider" data-current-provider="${esc(s.provider||'')}" data-current-key="${s.api_key_set?'true':'false'}" value="${esc(s.provider||'')}" placeholder="任意供应商名称"></div><div class="form-field"><label>官网链接（可选）</label><input class="field-input" name="website_url" value="${esc(s.website_url||'')}" placeholder="https://example.com"></div><div class="form-field full"><label>Base URL（可选，服务根地址）</label><input class="field-input" name="base_url" value="${esc(s.base_url||'')}" placeholder="https://api.example.com/v1"><span class="form-help">可只填写下面的 API 请求地址；两者至少填写一个。</span></div><div class="form-field full"><label>API 请求地址（可选，完整 POST 端点）</label><input class="field-input" name="api_url" value="${esc(s.api_url||'')}" placeholder="https://api.example.com/v1/chat/completions"><span class="form-help">填写后会原样调用，支持供应商自定义路径；留空时才根据 Base URL 自动拼接协议路径。</span></div><div class="form-field"><label>协议</label><select class="field-input" name="protocol"><option value="chat_completions" ${s.protocol!=='responses'?'selected':''}>Chat Completions</option><option value="responses" ${s.protocol==='responses'?'selected':''}>Responses</option></select></div><div class="form-field"><label>Model</label><input class="field-input" name="model" list="model-provider-hints" value="${esc(s.model||'')}" placeholder="模型 ID" required><datalist id="model-provider-hints">${modelHints}</datalist></div><div class="form-field"><label>Temperature</label><input class="field-input" name="temperature" type="number" min="0" max="2" step="0.1" value="${s.temperature??0.2}"></div><div class="form-field full"><label>API Key</label><input class="field-input" name="api_key" type="password" placeholder="${s.api_key_set?'已配置，留空表示保持不变':'填写 API Key'}" autocomplete="off"><span class="form-help">当前来源：${esc(s.api_key_source||'未配置')}。密钥不会回显。</span><label class="check-label" style="margin-top:8px"><input type="checkbox" name="persist_api_key" ${s.api_key_source==='环境变量'?'':'checked'}> 保存到本地密钥文件，服务更新或重启后自动读取</label><label class="check-label" style="margin-top:6px"><input type="checkbox" name="clear_api_key"> 清除本地密钥（API Key 留空时生效）</label></div><div class="form-field full"><label class="check-label"><input type="checkbox" name="enabled" ${s.enabled?'checked':''}> 启用模型助读</label></div></div><div id="model-config-status" style="margin-top:12px;font-size:10px;color:#748178"></div></div><div class="modal-foot"><button class="button" type="button" data-model-test>快速连通</button><button class="button" type="button" data-model-test="deep">首 token 实测</button><button class="button" type="button" data-close-modal>取消</button><button class="button primary" type="submit">保存配置</button></div></form>`,true);syncModelApiKeyRequirement($('#model-settings-form'));}).catch(e=>toast(e.message,'error'));}

async function createBackup(){try{toast('正在生成并校验备份…');const b=await api('/api/backup',{method:'POST',body:'{}'});const a=document.createElement('a');a.href=b.download_url;a.download=b.filename;document.body.append(a);a.click();a.remove();toast(`备份已生成：${b.filename}`);}catch(e){toast(e.message,'error');}}

async function saveReadingCard(id,button){const updates={};$$('[data-reading-field]',button.closest('.reading-card-section')||$('#modal-root')).forEach(field=>updates[field.dataset.readingField]=field.value);try{const card=await api(`/api/papers/${id}/reading-card`,{method:'PUT',body:jsonBody(updates)});const paper=papers.find(item=>item.id===id);if(paper)paper.reading_card=card;analytics=null;await refresh();if($('#modal-root').innerHTML)await openPaper(id);else if(activeView==='reading')renderView();toast(`阅读卡已保存 · 完成 ${card.completion_pct}%`);}catch(err){toast(err.message,'error');}}

async function updateSelectedPapers(updates){const ids=[...selectedLibraryIds];if(!ids.length)return;try{const result=await api('/api/papers/batch',{method:'POST',body:jsonBody({ids,updates})});selectedLibraryIds.clear();await refresh();analytics=null;toast(`已更新 ${result.updated} 篇${result.skipped?.length?`，跳过 ${result.skipped.length} 篇不存在的记录`:''}`);}catch(err){toast(err.message,'error');}}

async function showRunDetail(id){try{const run=await api(`/api/runs/${id}`);const status=run.status==='success'?'完成':run.status==='partial'?'部分失败':run.status==='running'?'运行中':'失败';const sourceRows=(run.source_details||[]).map(source=>`<section class="run-detail-source"><div class="section-heading" style="margin:0 0 8px"><b>${esc(SOURCE_NAME[source.source]||source.source)}</b><span class="log-state ${source.status==='ok'?'':'failed'}">${source.status==='ok'?'成功':'失败'}</span></div><div class="evaluation-grid"><div><small>抓取</small><b>${source.fetched??'—'}</b></div><div><small>过滤</small><b>${source.filtered??'—'}</b></div><div><small>候选</small><b>${source.accepted??'—'}</b></div><div><small>新增 / 重复</small><b>${source.new??'—'} / ${source.duplicates??'—'}</b></div></div>${source.error?`<p class="run-detail-error">${esc(source.error)}</p>`:''}${(source.variants||[]).length?`<div class="modal-section-title">检索变体</div>${source.variants.map(v=>`<div class="source-line"><span><b>${esc(v.kind||v.id||'检索式')}</b> · ${esc(v.query||'')}</span><span>${v.fetched??0} 抓取 · ${v.accepted??0} 候选</span></div>`).join('')}`:''}</section>`).join('')||'<div class="empty-state" style="padding:18px">旧版运行未保存来源级详情。</div>';openModal(`<div class="modal-head"><div><h3>检索运行详情</h3><p>${esc(run.query_name||'研究主题')} · ${fmtDate(run.started_at,true)} · ${status}</p></div><button class="close-button" data-close-modal>×</button></div><div class="modal-body"><div class="evaluation-grid"><div><small>新增</small><b>${run.new_count||0}</b></div><div><small>重复</small><b>${run.duplicate_count||0}</b></div><div><small>耗时</small><b>${run.started_at&&run.completed_at?`${Math.max(0,Math.round((new Date(run.completed_at)-new Date(run.started_at))/1000))} 秒`:'—'}</b></div><div><small>数据质量</small><b>${run.data_quality==='complete'?'来源详情完整':'历史详情缺失'}</b></div></div>${run.query?.query?`<div class="modal-section-title">检索问题</div><p style="font-size:10px;line-height:1.7;color:#66756b">${esc(run.query.query)}</p>`:''}<div class="modal-section-title">来源与查询路径</div>${sourceRows}</div><div class="modal-foot"><button class="button" data-close-modal>关闭</button></div>`);}catch(err){toast(err.message,'error');}}

const _showRunDetailCandidateCounts=showRunDetail;
showRunDetail=async function(id){await _showRunDetailCandidateCounts(id);try{const run=await api(`/api/runs/${encodeURIComponent(id)}`);const root=$('#modal-root');if(run.candidate_mode){const summary=root?.querySelector('.modal-body > .evaluation-grid');if(summary){summary.innerHTML=`<div><small>候选论文</small><b>${Number(run.candidate_count||0)}</b></div><div><small>已导入</small><b>${Number(run.imported_count||0)}</b></div><div><small>待确认</small><b>${Number(run.awaiting_review_count||0)}</b></div><div><small>耗时</small><b>${run.started_at&&run.completed_at?`${Math.max(0,Math.round((new Date(run.completed_at)-new Date(run.started_at))/1000))} 秒`:'—'}</b></div>`;}root?.querySelectorAll('.run-detail-source .evaluation-grid').forEach(grid=>grid.lastElementChild?.remove());}if(['failed','partial','interrupted','retryable'].includes(run.status)){const foot=root?.querySelector('.modal-foot');if(foot&&!foot.querySelector('[data-discovery-history-rerun]'))foot.insertAdjacentHTML('afterbegin',`<button class="button primary" data-discovery-history-rerun="${esc(run.id||id)}">按原条件重试</button>`);}}catch{}};

async function showPaperHistory(id){try{const data=await api(`/api/papers/${id}/history`);const rows=(data.revisions||[]).map(item=>{const content=item.content||{};const preview=item.revision_type==='notes'?(content.notes||''):(content.research_question||content.contribution||'阅读卡快照');return `<div class="source-line" style="align-items:flex-start;gap:10px"><div><b>${item.revision_type==='notes'?'个人笔记':'结构化阅读卡'}</b><small style="display:block;color:#94a098;margin-top:3px">${fmtDate(item.created_at,true)} · ${esc(item.source||'user')}</small><span style="display:block;margin-top:5px;max-width:430px;white-space:pre-wrap">${esc(preview.slice(0,260))}</span></div><button class="button small" data-restore-revision="${item.id}" data-restore-paper="${id}">恢复</button></div>`}).join('')||'<div class="empty-state" style="padding:18px">还没有保存过历史版本。</div>';openModal(`<div class="modal-head"><div><h3>论文历史版本</h3><p>恢复会创建新的版本记录，现有历史不会被删除。</p></div><button class="close-button" data-close-modal>×</button></div><div class="modal-body">${rows}</div><div class="modal-foot"><button class="button" data-close-modal>关闭</button></div>`);}catch(err){toast(err.message,'error');}}

